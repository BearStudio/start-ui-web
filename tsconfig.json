{
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitAny": true,
    "paths": {
      "@/*": ["./src/*"],
      "e2e/*": ["./e2e/*"]
    },
    "typeRoots": ["node_modules/@types", "src/types"]
  }
}
